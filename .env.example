# Copy to .env before the first `docker compose up`. .env is gitignored.
#
# Note what is NOT here: the Telegram bot token, chat whitelist, shop timezone,
# UI language and stale-order threshold are all rows in the settings table,
# edited at /settings in the web UI. The bot re-reads them every poll cycle, so
# changing them takes effect with no restart -- moving them to env would lose that.

# --- First-run admin account ---------------------------------------------
# Only used to seed an empty database. Changing these later does nothing;
# change the password in the web UI instead. Leaving SHOP_ADMIN_PASSWORD unset
# falls back to the documented default admin123 and logs a warning at startup.
SHOP_ADMIN_USERNAME=admin
SHOP_ADMIN_PASSWORD=change-me-before-first-start

# --- Sessions -------------------------------------------------------------
# Optional. Left unset, a random key is generated once and persisted to
# SHOP_SECRET_KEY_PATH (inside the /data volume), so logins survive restarts.
# Set it explicitly only if you want to control key rotation yourself.
# SHOP_SECRET_KEY=

# --- Encryption at rest ---------------------------------------------------
# The Telegram bot token is stored encrypted in the database. Left unset, a key
# is generated once and persisted to SHOP_ENCRYPTION_KEY_PATH -- which sits
# beside the database but is NOT included in backup.sh output, so a leaked
# backup cannot be decrypted.
#
# Set it explicitly if you want the key somewhere you control (a password
# manager) instead of only on the server's disk. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing the key is recoverable: the bot idles and you re-enter the token in
# Settings. An invalid value here fails at startup rather than silently.
# SHOP_ENCRYPTION_KEY=

# --- Paths ----------------------------------------------------------------
# Defaults below are already set in the Dockerfile; override only to relocate.
# SHOP_DB_PATH=/data/shop.db
# SHOP_SECRET_KEY_PATH=/data/.secret_key
# SHOP_ENCRYPTION_KEY_PATH=/data/.encryption_key

# --- Networking -----------------------------------------------------------
# Host port the shop reaches the app on, e.g. http://192.168.1.50:5000
HOST_PORT=5000

# --- Misc -----------------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Set to 0 to run the web UI without the Telegram poller.
SHOP_ENABLE_BOT=1

# Never set FLASK_DEBUG in a deployment: it exposes the Werkzeug console, which
# is remote code execution for anyone who can reach the port.
